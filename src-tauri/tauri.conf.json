{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legere",
  "version": "0.1.0",
  "identifier": "com.ritvijsrivastava.legere",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../frontend" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../frontend" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/build"
  },
  "app": {
    "windows": [
      {
        "title": "Legere",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost legere-content: http://legere-content.localhost data:; media-src 'self' asset: http://asset.localhost legere-content: http://legere-content.localhost; frame-src 'self' legere-content: http://legere-content.localhost; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/legere/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "app", "dmg", "nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 30
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_ME_RUN_NPM_RUN_TAURI_SIGNER_GENERATE",
      "endpoints": [
        "https://github.com/ritvijsrivastava/legere/releases/latest/download/latest.json"
      ]
    }
  }
}
